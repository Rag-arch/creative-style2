<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>私という作風</title>

    <!-- ▼▼▼ OGP・X用カード設定 ▼▼▼ -->
    <meta property="og:title" content="私という作風 - 創作の傾向診断">
    <meta property="og:description" content="全24問の質問と画像選択から、あなたの「創作の傾向（3軸の組み合わせ）」を診断します。">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://rag-arch.github.io/creative-style">
    <meta property="og:image" content="https://rag-arch.github.io/creative-style/ogp-v3.png">
    <meta property="og:site_name" content="私という作風">

    <meta name="twitter:card" content="summary_large_image">
    <!-- ▲▲▲ OGP設定ここまで ▲▲▲ -->

    <!-- html2canvas ライブラリ (画像ダウンロード機能用) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <style>
        :root {
            --bg-color: #e8e4dc;
            --card-bg: #ffffff;
            --text-main: #2b2b2b;
            --text-sub: #666666;
            --accent-color: #2c3e50;
            --border-color: #d8d4cd;
            --font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Segoe UI", "Hiragino Kaku Gothic ProN", "Hiragino Sans", Meiryo, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-text-size-adjust: 100%;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: var(--font-family);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 12px;
            letter-spacing: 0.05em;
            line-height: 1.5;
        }

        .container {
            width: 100%;
            max-width: 540px;
            margin: 0 auto;
        }

        .screen {
            display: none;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .screen.active {
            display: block;
            opacity: 1;
        }

        /* ----- UI / スタート・質問・画像選択画面 ----- */
        h1.main-title {
            font-size: 2.2rem;
            font-weight: 900;
            text-align: center;
            letter-spacing: 0.2em;
            margin-bottom: 1.5rem;
            text-transform: uppercase;
        }

        .start-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            width: 100%;
            margin: 0 auto;
        }

        .subtitle {
            text-align: center;
            font-size: 0.85rem;
            color: var(--text-sub);
            margin-bottom: 2.5rem;
            line-height: 1.8;
            width: 100%;
        }

        .btn {
            display: inline-block;
            width: 100%;
            padding: 14px 24px;
            background: #ffffff;
            color: var(--text-main);
            border: 1px solid var(--text-main);
            font-size: 0.9rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            cursor: pointer;
            transition: all 0.2s ease;
            text-align: center;
            text-decoration: none;
            border-radius: 0;
        }

        .btn-start {
            width: 100%;
        }

        .btn:hover {
            background: var(--text-main);
            color: #ffffff;
        }

        .btn:disabled {
            border-color: #ccc;
            color: #ccc;
            cursor: not-allowed;
            background: transparent;
        }

        .btn-group {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 16px;
        }

        .btn-secondary {
            border-color: var(--border-color);
            color: var(--text-sub);
            background: #ffffff;
        }

        .btn-secondary:hover {
            background: #f0f0f0;
            color: var(--text-main);
            border-color: var(--text-main);
        }

        /* 質問カード共通 */
        .q-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.2rem;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 8px;
        }

        .q-number {
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 0.15em;
        }

        .q-title {
            font-size: 1.15rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            text-align: center;
            line-height: 1.5;
        }

        /* 8択グリッド用スタイル */
        .grid-instruction {
            font-size: 0.8rem;
            text-align: center;
            color: var(--text-sub);
            margin-bottom: 0.8rem;
            font-weight: 600;
        }

        .options-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
            margin-bottom: 1.5rem;
        }

        .grid-item {
            aspect-ratio: 1 / 1;
            border: 2px solid var(--border-color);
            cursor: pointer;
            position: relative;
            overflow: hidden;
            background: #fff;
            border-radius: 0;
            transition: all 0.2s ease;
        }

        .grid-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            pointer-events: none;
            -webkit-user-drag: none;
            user-select: none;
        }

        .grid-item.selected {
            border-color: var(--text-main);
            box-shadow: 0 0 0 2px var(--text-main);
        }

        /* 1番目に選んだ場合の番号表示スタイル */
        .grid-item.selected-1::after {
            content: "1";
            position: absolute;
            top: 4px;
            right: 4px;
            background: var(--text-main);
            color: #fff;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: bold;
        }

        /* 2番目に選んだ場合の番号表示スタイル */
        .grid-item.selected-2::after {
            content: "2";
            position: absolute;
            top: 4px;
            right: 4px;
            background: #555555;
            color: #fff;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: bold;
        }

        /* 画像アップロード画面 */
        .file-upload-wrapper {
            margin-bottom: 1.5rem;
            text-align: center;
        }

        .file-input {
            display: none;
        }

        .file-label {
            border: 1px dashed var(--text-main);
            padding: 30px 20px;
            display: block;
            cursor: pointer;
            background: #fff;
            border-radius: 0;
            transition: background 0.2s, border 0.2s;
        }

        .file-label.has-image {
            border: none;
            padding: 5px 0;
            background: transparent;
        }

        .preview-mini {
            max-width: 160px;
            max-height: 160px;
            margin: 10px auto 0;
            display: none;
            object-fit: cover;
            border-radius: 0;
        }

        .reason-wrapper {
            margin-top: 1.2rem;
            text-align: left;
        }

        .reason-label {
            display: block;
            font-size: 0.85rem;
            font-weight: 700;
            margin-bottom: 6px;
            color: var(--text-main);
        }

        .reason-textarea {
            width: 100%;
            height: 70px;
            padding: 8px 10px;
            font-family: var(--font-family);
            font-size: 0.85rem;
            border: 1px solid var(--border-color);
            border-radius: 0;
            resize: vertical;
            outline: none;
            background: #fff;
        }

        .reason-textarea:focus {
            border-color: var(--text-main);
        }

        /* ----- 最終結果カード (全画面フルサイズ対応・iPhone崩れ防止) ----- */
        .result-card-container {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            margin: 0 auto;
        }

        .result-card {
            background-color: var(--card-bg);
            border-radius: 0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            padding: 12px 14px;
            margin-bottom: 12px;
            border: 1px solid var(--border-color);
            width: 100%;
            max-width: 100%;
            transition: background 0.5s ease;
            overflow: hidden;
        }

        .card-header {
            text-align: center;
            margin-bottom: 6px;
        }

        .app-title {
            font-size: 9px;
            color: var(--text-sub);
            letter-spacing: 0.1em;
            margin: 0 0 1px 0;
        }

        .type-count-info {
            text-align: center;
            font-size: 7px;
            color: var(--text-sub);
            margin-top: 2px;
            margin-bottom: 6px;
            letter-spacing: 0.02em;
        }

        /* 3軸の完全な位置合わせグリッド (iPhone幅を考慮) */
        .axes-grid-layout {
            display: grid;
            grid-template-columns: 1fr auto 1fr auto 1fr;
            align-items: baseline;
            justify-items: center;
            max-width: 100%;
            margin: 0 auto 8px auto;
            overflow-x: auto;
        }

        .axis-col-1 { grid-column: 1; }
        .axis-sep-1 { grid-column: 2; }
        .axis-col-2 { grid-column: 3; }
        .axis-sep-2 { grid-column: 4; }
        .axis-col-3 { grid-column: 5; }

        .axis-label-item {
            font-size: 7.5px;
            color: var(--text-sub);
            letter-spacing: 0.05em;
            font-weight: bold;
            margin-bottom: 2px;
            white-space: nowrap;
        }

        .axis-val-item {
            font-size: clamp(16px, 5vw, 21px);
            font-weight: 900;
            letter-spacing: 0.03em;
            white-space: nowrap;
        }

        .axis-separator {
            color: var(--text-sub);
            font-weight: normal;
            font-size: 14px;
            padding: 0 2px;
        }

        .catchphrase {
            font-size: 10.5px;
            font-weight: bold;
            color: var(--accent-color);
            margin-bottom: 6px;
            text-align: center;
            word-break: break-all;
        }

        /* 画像エリア (横16：縦9に固定) */
        .image-section {
            width: 100%;
            aspect-ratio: 16 / 9;
            background-color: rgba(255, 255, 255, 0.7);
            border-radius: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-sub);
            margin-bottom: 3px;
            border: none;
            position: relative;
            overflow: hidden;
            text-align: center;
            font-size: 0.75rem;
        }

        .image-section img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 0;
        }

        .card-reason-text {
            font-size: 9.5px;
            color: var(--text-sub);
            text-align: center;
            margin-bottom: 6px;
            min-height: 1.2em;
            word-break: break-all;
        }

        /* セクションブロック */
        .section-block {
            margin-bottom: 6px;
            background-color: transparent;
            padding: 4px 0;
            border: none;
        }

        .section-title {
            font-size: 10.5px;
            font-weight: bold;
            border-bottom: 2px solid var(--accent-color);
            padding-bottom: 1px;
            margin-bottom: 4px;
        }

        .axis-item {
            margin-bottom: 4px;
        }

        .axis-name {
            font-size: 9.5px;
            font-weight: bold;
            color: var(--text-main);
        }

        .axis-desc {
            font-size: 8px;
            color: var(--text-sub);
            margin-top: 1px;
            line-height: 1.3;
        }

        .desc-sentence {
            display: block;
        }

        .desc-keywords {
            display: block;
            font-size: 7px;
            color: #777;
            margin-top: 1px;
        }

        .another-type {
            background-color: transparent;
            padding: 4px 0;
            border-radius: 0;
            text-align: center;
            margin-bottom: 6px;
            border: none;
        }

        .another-type h4 {
            font-size: 9px;
            color: var(--text-sub);
            margin: 0 0 1px 0;
        }

        .another-type p {
            font-weight: bold;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: baseline;
            gap: 3px;
            flex-wrap: wrap;
            font-size: 10.5px;
        }

        .sub-axis-rate {
            font-size: 7.5px;
            color: var(--text-sub);
            font-weight: normal;
        }

        .card-footer-note {
            font-size: 7px;
            color: var(--text-sub);
            border-top: 1px solid var(--border-color);
            padding-top: 4px;
            text-align: justify;
            line-height: 1.25;
        }
    </style>
</head>
<body>

<div class="container">

    <!-- START SCREEN -->
    <div id="screen-start" class="screen active">
        <div class="start-container">
            <h1 class="main-title">私という作風</h1>
            <p class="subtitle">
                あなたは、何を美しいと思い、<br>
                何を通して表現し、<br>
                何を誰かにもたらしたい人？<br><br>
                全24問の質問から、あなたの「創作の傾向」を診断します。<br><br>
                <span style="font-size: 0.75rem; color: var(--text-sub);">※本診断で使用している画像はAIによって生成されています。</span>
            </p>
            <button class="btn btn-start" onclick="startQuiz()">診断を開始する</button>
        </div>
    </div>

    <!-- QUIZ SCREEN -->
    <div id="screen-quiz" class="screen">
        <div class="q-header">
            <span class="q-number" id="q-number">Q1 / 24</span>
        </div>
        <div class="q-title" id="q-title">質問タイトル</div>
        <div id="q-content-area"></div>
        <div class="btn-group">
            <button class="btn btn-secondary" id="btn-prev-q" onclick="prevQuestion()">一つ戻る</button>
        </div>
    </div>

    <!-- IMAGE UPLOAD SCREEN -->
    <div id="screen-image" class="screen">
        <div class="q-header">
            <span class="q-number">VISUAL</span>
        </div>
        <div class="q-title">あなたを象徴する画像を1枚選んでください（比率16:9固定）</div>
        <div class="file-upload-wrapper">
            <label class="file-label" id="file-label-box" for="char-image-input">
                <span id="file-label-text">画像ファイルを選択 (ローカル処理)</span>
                <img id="preview-img" class="preview-mini" src="" alt="preview">
            </label>
            <input type="file" id="char-image-input" class="file-input" accept="image/*" onchange="handleImageUpload(event)">
            
            <div class="reason-wrapper">
                <label class="reason-label" for="image-reason-input">この一枚を選んだ理由</label>
                <textarea id="image-reason-input" class="reason-textarea" placeholder="この画像を選んだ理由や、思い入れなどを入力してください"></textarea>
            </div>
        </div>
        <div class="btn-group">
            <button class="btn btn-secondary" onclick="prevScreenFromImage()">戻る</button>
            <button class="btn" id="btn-show-result" onclick="calculateAndShowResult()" disabled>結果を見る</button>
        </div>
    </div>

    <!-- RESULT SCREEN -->
    <div id="screen-result" class="screen">
        <div class="result-card-container">
            <div class="result-card" id="result-card">
                
                <!-- ① タイトル -->
                <div class="card-header">
                    <p class="app-title">512 TYPES</p>
                    <h2 style="margin:0; font-size: 15px;">私という作風</h2>
                    <div class="type-count-info">3つの軸の組み合わせからあなたの作風を導き出します</div>
                </div>

                <!-- ② 3軸グリッド ([MEDIUM] × [STYLE] × [PURPOSE]) -->
                <div class="axes-grid-layout" id="res-axes-grid"></div>

                <!-- ③ キャッチコピー ([PURPOSE]、[STYLE]) -->
                <div class="catchphrase" id="res-catchphrase"></div>

                <!-- ④ あなたを象徴する一枚 -->
                <div class="image-section" id="imageDropZone">
                    <img id="res-image" src="" alt="Character" style="display:none;">
                    <span id="res-image-placeholder">[ あなたを象徴する一枚 (16:9) ]<br>画像をここに配置</span>
                </div>
                <div class="card-reason-text" id="res-reason"></div>

                <!-- ⑤ 3軸の解説 -->
                <div class="section-block">
                    <div class="section-title">3軸の解説</div>
                    <div id="res-axis-details"></div>
                </div>

                <!-- ⑥ 作風分析 -->
                <div class="section-block">
                    <div class="section-title">作風分析</div>
                    <div class="axis-item">
                        <div class="axis-name" id="profile-title-1">作風の輪郭 ｜ 尖鋭型</div>
                        <div class="axis-desc" id="profile-desc-1">ここに解説が入ります。</div>
                    </div>
                </div>

                <!-- ⑦ もう一つのあなた -->
                <div class="another-type">
                    <h4>もう一つのあなた</h4>
                    <p id="res-sub-axes">視覚 × 理想 × 探究</p>
                </div>

                <!-- ⑧ 小さな注記 -->
                <div class="card-footer-note">
                    ※この診断は、回答時点の創作に対する好みや価値観から、現在の「作風の傾向」を可視化するものです。<br>
                     人の創作や価値観を固定的に分類するものではありません。
                </div>

            </div>
        </div>

        <div class="btn-group" style="margin-bottom: 20px;">
            <button class="btn" onclick="downloadResultImage()">結果を画像で保存・ダウンロード</button>
            
            <div style="text-align: center; margin: 16px 0; font-size: 0.8rem; color: var(--text-sub); letter-spacing: 0.1em;">
                <div style="font-weight: 700; font-size: 0.75rem; margin-bottom: 3px;">SHARE YOUR STYLE</div>
                <div>結果画像を保存して、Xでシェアしよう。</div>
            </div>

            <button class="btn btn-secondary" onclick="backToImageScreen()">回答や写真を修正する</button>
            <button class="btn btn-secondary" onclick="restart()">最初からやり直す</button>
        </div>
    </div>

</div>

<script>
// ここにGoogle Apps Script（GAS）で発行したご自身のウェブアプリのURLを設定してください
const GAS_WEB_APP_URL = "https://script.google.com/macros/s/AKfycbw3FEnDk7Q_cC2neeP7wQshupYrUh8SuO-wBKsXRTFlTnD4Dbb0BA6dzZwL8ok-hN2M/exec";

const COLOR_STYLE = {
    "再現": "#B71C1C", "理想": "#E65100", "表現": "#AD1457", "知覚": "#F57F17",
    "構成": "#283593", "幻想": "#6A1B9A", "概念": "#1A237E", "変容": "#00695C"
};

const COLOR_MEDIUM = {
    "視覚": "#E53935", "造形": "#F57C00", "空間": "#FBC02D", "音響": "#43A047",
    "言語": "#1E88E5", "身体": "#8E44AD", "映像": "#E85D8E", "体験": "#00ACC1"
};

const COLOR_PURPOSE = {
    "美":   "#C2185B", "探究": "#303F9F", "伝達": "#0288D1", "共感": "#388E3C",
    "娯楽": "#E65100", "思索": "#7B1FA2", "癒し": "#00838F", "感動": "#D32F2F"
};

// 全24問を8択の画像問題として定義し、指定された順序（元データ配列のインデックス順：14番目、13番目、15番目、17番目、16番目、18番目、20番目、19番目、21番目、23番目、22番目、24番目、および1〜12番目の順序）に再配置
const BASE_QUESTIONS = [
    {
        q: "どの世界が好き？", category: "STYLE",
        items: [
            { label: "再現", img: "./images/A1再現.jpg" }, { label: "理想", img: "./images/A2理想.jpg" },
            { label: "表現", img: "./images/A3表現.jpg" }, { label: "知覚", img: "./images/A4知覚.jpg" },
            { label: "構成", img: "./images/A5構成.jpg" }, { label: "幻想", img: "./images/A6幻想.jpg" },
            { label: "概念", img: "./images/A7概念.jpg" }, { label: "変容", img: "./images/A8変容.jpg" }
        ]
    },
    {
        q: "アイデアを何にしたい？", category: "MEDIUM",
        items: [
            { label: "視覚", img: "./images/B1視覚.jpg" }, { label: "造形", img: "./images/B2造形.jpg" },
            { label: "空間", img: "./images/B3空間.jpg" }, { label: "音響", img: "./images/B4音響.jpg" },
            { label: "言語", img: "./images/B5言語.jpg" }, { label: "身体", img: "./images/B6身体.jpg" },
            { label: "映像", img: "./images/B7映像.jpg" }, { label: "体験", img: "./images/B8体験.jpg" }
        ]
    },
    {
        q: "何と言われたい？", category: "PURPOSE",
        items: [
            { label: "美", img: "./images/C1美.jpg" }, { label: "探究", img: "./images/C2探求.jpg" },
            { label: "伝達", img: "./images/C3伝達.jpg" }, { label: "共感", img: "./images/C4共感.jpg" },
            { label: "娯楽", img: "./images/C5娯楽.jpg" }, { label: "思索", img: "./images/C6思索.jpg" },
            { label: "癒し", img: "./images/C7癒し.jpg" }, { label: "感動", img: "./images/C8感動.jpg" }
        ]
    },
    {
        q: "何をつくりたい？", category: "STYLE",
        items: [
            { label: "再現", img: "./images/D1再現.jpg" }, { label: "理想", img: "./images/D2理想.jpg" },
            { label: "表現", img: "./images/D3表現.jpg" }, { label: "知覚", img: "./images/D4知覚.jpg" },
            { label: "構成", img: "./images/D5構成.jpg" }, { label: "幻想", img: "./images/D6幻想.jpg" },
            { label: "概念", img: "./images/D7概念.jpg" }, { label: "変容", img: "./images/D8変容.jpg" }
        ]
    },
    {
        q: "作品の中で、人に何をしてもらいたい？", category: "MEDIUM",
