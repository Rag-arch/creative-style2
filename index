    "概念": { catchPhrase: "常識の異端児", title: "概念 ｜ 見えないものを形にする人", text: "思想、意味、問い、価値観など、目に見えないものを作品として提示する創作傾向。何が美しいかだけでなく、この作品は何を意味するのかを重視する。作品そのものだけでなく、その背景にある考えや問いが創作の核になることも多い。", keywords: "意味・思想・問い・本質・コンセプト" },
    "変容": { catchPhrase: "既成概念の破壊者", title: "変容 ｜ 世界を書き換える人", text: "既存のものを変形・再解釈・融合し、新しい価値へと変える創作傾向。ゼロからつくるだけでなく、すでにあるものを別のものへ変えることに創造性を感じる。異なるジャンルを融合したり、既存の常識を反転させたりすることもある。", keywords: "変化・再解釈・融合・改変・革新" }
};

const STYLE_ORDER = ["再現", "理想", "表現", "知覚", "構成", "幻想", "概念", "変容"];
const MEDIUM_ORDER = ["視覚", "造形", "空間", "音響", "言語", "身体", "映像", "体験"];
const PURPOSE_ORDER = ["美", "探究", "伝達", "共感", "娯楽", "思索", "癒し", "感動"];

let currentQuestionIndex = 0;
let userAnswers = [];
let uploadedImageData = null;
let calculatedResultsData = null;
let isDownloading = false;

function hexToRgb(hex) {
    let cleanHex = hex.replace('#', '');
    if (cleanHex.length === 3) {
        cleanHex = cleanHex.split('').map(char => char + char).join('');
    }
    const num = parseInt(cleanHex, 16);
    return {
        r: (num >> 16) & 255,
        g: (num >> 8) & 255,
        b: num & 255
    };
}

function formatDescWithLineBreaks(text, keywords) {
    const sentences = text.split('。').filter(s => s.trim().length > 0).map(s => s + '。');
    let html = '';
    sentences.forEach(s => {
        html += `<span class="desc-sentence">${s}</span>`;
    });
    if (keywords) {
        html += `<span class="desc-keywords">[${keywords}]</span>`;
    }
    return html;
}

function showScreen(screenId) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.getElementById(screenId).classList.add('active');
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

function startQuiz() {
    currentQuestionIndex = 0;
    userAnswers = [];
    renderQuestion();
    showScreen('screen-quiz');
}

function renderQuestion() {
    const qData = QUESTIONS[currentQuestionIndex];
    document.getElementById('q-number').textContent = `Q${currentQuestionIndex + 1} / ${QUESTIONS.length}`;
    document.getElementById('q-title').textContent = qData.q;

    const contentArea = document.getElementById('q-content-area');
    contentArea.innerHTML = '';

    const instruction = document.createElement('div');
    instruction.className = 'grid-instruction';
    instruction.textContent = "画像の中から2つ選んでください（選んだ順番に1位2位表示）\n※問題内の画像はAI生成画像です";
    instruction.style.whiteSpace = "pre-line";
    contentArea.appendChild(instruction);

    const optionsGrid = document.createElement('div');
    optionsGrid.className = 'options-grid';

    let currentSelections = userAnswers[currentQuestionIndex];
    if (!Array.isArray(currentSelections)) {
        currentSelections = [];
    }

    qData.items.forEach((itemData) => {
        const gridItem = document.createElement('div');
        gridItem.className = 'grid-item';
        
        const selectionIndex = currentSelections.indexOf(itemData.label);
        if (selectionIndex > -1) {
            gridItem.classList.add('selected');
            gridItem.classList.add(`selected-${selectionIndex + 1}`);
        }

        gridItem.innerHTML = `<img src="${itemData.img}" alt="${itemData.label}" draggable="false">`;
        gridItem.onclick = () => toggleGridItemSelection(itemData.label);
        optionsGrid.appendChild(gridItem);
    });
    contentArea.appendChild(optionsGrid);

    const prevBtn = document.getElementById('btn-prev-q');
    if (currentQuestionIndex === 0) {
        prevBtn.textContent = "TOPへ戻る";
        prevBtn.onclick = () => showScreen('screen-start');
    } else {
        prevBtn.textContent = "一つ戻る";
        prevBtn.onclick = () => prevQuestion();
    }
}

function toggleGridItemSelection(label) {
    let currentSelections = userAnswers[currentQuestionIndex];
    if (!Array.isArray(currentSelections)) {
        currentSelections = [];
    }

    const index = currentSelections.indexOf(label);
    if (index > -1) {
        currentSelections.splice(index, 1);
    } else {
        if (currentSelections.length < 2) {
            currentSelections.push(label);
        } else {
            currentSelections.shift();
            currentSelections.push(label);
        }
    }

    userAnswers[currentQuestionIndex] = currentSelections;
    renderQuestion();

    if (currentSelections.length === 2) {
        setTimeout(() => {
            if (currentQuestionIndex < QUESTIONS.length - 1) {
                currentQuestionIndex++;
                renderQuestion();
            } else {
                showScreen('screen-image');
            }
        }, 300);
    }
}

function prevQuestion() {
    if (currentQuestionIndex > 0) {
        currentQuestionIndex--;
        renderQuestion();
    }
}

function prevScreenFromImage() {
    currentQuestionIndex = QUESTIONS.length - 1;
    renderQuestion();
    showScreen('screen-quiz');
}

function backToImageScreen() {
    showScreen('screen-image');
}

function handleImageUpload(event) {
    const file = event.target.files[0];
    if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
            uploadedImageData = e.target.result;
            const preview = document.getElementById('preview-img');
            preview.src = uploadedImageData;
            preview.style.display = 'block';
            document.getElementById('file-label-text').textContent = "画像を変更する";
            document.getElementById('btn-show-result').disabled = false;
            document.getElementById('file-label-box').classList.add('has-image');
        };
        reader.readAsDataURL(file);
    }
}

function calculateScores() {
    const scoreMap = { STYLE: {}, MEDIUM: {}, PURPOSE: {} };
    
    STYLE_ORDER.forEach(k => scoreMap.STYLE[k] = { total: 0, mainCount: 0, subCount: 0, grid1Count: 0, grid2Count: 0 });
    MEDIUM_ORDER.forEach(k => scoreMap.MEDIUM[k] = { total: 0, mainCount: 0, subCount: 0, grid1Count: 0, grid2Count: 0 });
    PURPOSE_ORDER.forEach(k => scoreMap.PURPOSE[k] = { total: 0, mainCount: 0, subCount: 0, grid1Count: 0, grid2Count: 0 });

    userAnswers.forEach((ansData, qIdx) => {
        if (ansData === undefined) return;
        const qData = QUESTIONS[qIdx];

        if (Array.isArray(ansData)) {
            const category = qData.category;
            ansData.forEach((selectedKey, idx) => {
                if (scoreMap[category][selectedKey]) {
                    // 配点変更：1位を2点、2位を1点に変更
                    const points = (idx === 0) ? 2 : 1;
                    scoreMap[category][selectedKey].total += points;
                    
                    if (idx === 0) {
                        scoreMap[category][selectedKey].grid1Count += 1;
                    } else {
                        scoreMap[category][selectedKey].grid2Count += 1;
                    }
                }
            });
        }
    });

    function getSortedRankList(category, orderList) {
        const catMap = scoreMap[category];
        const sortedDesc = [...orderList].sort((a, b) => {
            const itemA = catMap[a];
            const itemB = catMap[b];
            
            if (itemB.total !== itemA.total) return itemB.total - itemA.total;
            if (itemB.mainCount !== itemA.mainCount) return itemB.mainCount - itemA.mainCount;
            if (itemB.grid1Count !== itemA.grid1Count) return itemB.grid1Count - itemA.grid1Count;
            if (itemB.grid2Count !== itemA.grid2Count) return itemB.grid2Count - itemA.grid2Count;
            if (itemB.subCount !== itemA.subCount) return itemB.subCount - itemA.subCount;
            
            return orderList.indexOf(a) - orderList.indexOf(b);
        });

        const top1Score = catMap[sortedDesc[0]].total;
        const top2Score = catMap[sortedDesc[1]].total;
        const ratio2 = top1Score > 0 ? (top2Score / top1Score) : 1.0;

        return {
            rank1: { key: sortedDesc[0], score: top1Score },
            rank2: { key: sortedDesc[1], score: top2Score, ratio: ratio2 },
            diff2Percent: top1Score > 0 ? ((top1Score - top2Score) / top1Score) * 100 : 0
        };
    }

    const styleRes = getSortedRankList("STYLE", STYLE_ORDER);
    const mediumRes = getSortedRankList("MEDIUM", MEDIUM_ORDER);
    const purposeRes = getSortedRankList("PURPOSE", PURPOSE_ORDER);

    return {
        style: styleRes,
        medium: mediumRes,
        purpose: purposeRes,
        avgDiffPercent: (styleRes.diff2Percent + mediumRes.diff2Percent + purposeRes.diff2Percent) / 3
    };
}

function recordDownloadStats(finalStyle, finalMedium, finalPurpose) {
    try {
        const STORAGE_KEY = "creative_style_dl_stats_v1";
        let stats = JSON.parse(localStorage.getItem(STORAGE_KEY)) || {
            totalDownloads: 0,
            STYLE: {},
            MEDIUM: {},
            PURPOSE: {}
        };

        STYLE_ORDER.forEach(k => { if (!stats.STYLE[k]) stats.STYLE[k] = 0; });
        MEDIUM_ORDER.forEach(k => { if (!stats.MEDIUM[k]) stats.MEDIUM[k] = 0; });
        PURPOSE_ORDER.forEach(k => { if (!stats.PURPOSE[k]) stats.PURPOSE[k] = 0; });

        stats.totalDownloads += 1;
        stats.STYLE[finalStyle] += 1;
        stats.MEDIUM[finalMedium] += 1;
        stats.PURPOSE[finalPurpose] += 1;

        localStorage.setItem(STORAGE_KEY, JSON.stringify(stats));

        if (GAS_WEB_APP_URL && GAS_WEB_APP_URL !== "") {
            fetch(GAS_WEB_APP_URL, {
                method: "POST",
                mode: "no-cors",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({
                    style: finalStyle,
                    medium: finalMedium,
                    purpose: finalPurpose
                })
            }).catch(err => {
                console.error("GAS送信エラー:", err);
            });
        }
    } catch (e) {
        console.error("集計データの保存に失敗しました", e);
    }
}

function calculateAndShowResult() {
    if (!uploadedImageData) return;
    const res = calculateScores();
    calculatedResultsData = res;

    const finalStyle = res.style.rank1.key;
    const finalMedium = res.medium.rank1.key;
    const finalPurpose = res.purpose.rank1.key;

    const colorS = COLOR_STYLE[finalStyle] || "#2c3e50";
    const colorM = COLOR_MEDIUM[finalMedium] || "#2c3e50";
    const colorP = COLOR_PURPOSE[finalPurpose] || "#2c3e50";

    const rgbS = hexToRgb(colorS);
    const rgbM = hexToRgb(colorM);
    const rgbP = hexToRgb(colorP);

    const resultCard = document.getElementById('result-card');
    resultCard.style.background = `linear-gradient(135deg, 
        rgba(${rgbM.r}, ${rgbM.g}, ${rgbM.b}, 0.24) 0%, 
        rgba(${rgbS.r}, ${rgbS.g}, ${rgbS.b}, 0.22) 50%, 
        rgba(${rgbP.r}, ${rgbP.g}, ${rgbP.b}, 0.22) 100%)`;

    document.getElementById('res-axes-grid').innerHTML = `
        <div class="axis-col-1 axis-label-item">[MEDIUM]</div>
        <div class="axis-sep-1 axis-separator" style="visibility:hidden;">×</div>
        <div class="axis-col-2 axis-label-item">[STYLE]</div>
        <div class="axis-sep-2 axis-separator" style="visibility:hidden;">×</div>
        <div class="axis-col-3 axis-label-item">[PURPOSE]</div>

        <div class="axis-col-1 axis-val-item" style="color: ${colorM}">${finalMedium}</div>
        <div class="axis-sep-1 axis-separator">×</div>
        <div class="axis-col-2 axis-val-item" style="color: ${colorS}">${finalStyle}</div>
        <div class="axis-sep-2 axis-separator">×</div>
        <div class="axis-col-3 axis-val-item" style="color: ${colorP}">${finalPurpose}</div>
    `;

    const dataP = DATA_PURPOSE[finalPurpose];
    const dataS = DATA_STYLE[finalStyle];
    
    document.getElementById('res-catchphrase').textContent = `${dataP.catchPhrase}、${dataS.catchPhrase}`;

    const resImg = document.getElementById('res-image');
    resImg.src = uploadedImageData;
    resImg.style.display = 'block';
    document.getElementById('res-image-placeholder').style.display = 'none';

    const reasonInput = document.getElementById('image-reason-input').value.trim();
    document.getElementById('res-reason').textContent = reasonInput !== '' ? `“${reasonInput}”` : '';

    const dataMed = DATA_MEDIUM[finalMedium];
    
    const formattedDescS = formatDescWithLineBreaks(dataS.text, dataS.keywords);
    const formattedDescMed = formatDescWithLineBreaks(dataMed.text, dataMed.keywords);
    const formattedDescP = formatDescWithLineBreaks(dataP.text, dataP.keywords);

    document.getElementById('res-axis-details').innerHTML = `
        <div class="axis-item">
            <div class="axis-name">MEDIUM：<span style="color: ${colorM}">${finalMedium}</span> ｜ ${dataMed.title.split(' ｜ ')[1]}</div>
            <div class="axis-desc">${formattedDescMed}</div>
        </div>
        <div class="axis-item">
            <div class="axis-name">STYLE：<span style="color: ${colorS}">${finalStyle}</span> ｜ ${dataS.title.split(' ｜ ')[1]}</div>
            <div class="axis-desc">${formattedDescS}</div>
        </div>
        <div class="axis-item">
            <div class="axis-name">PURPOSE：<span style="color: ${colorP}">${finalPurpose}</span> ｜ ${dataP.title}</div>
            <div class="axis-desc">${formattedDescP}</div>
        </div>
    `;

    const avg = res.avgDiffPercent;
    let profileTypeName = "";
    let profileDescText = "";

    if (avg >= 40) {
        profileTypeName = "尖鋭型";
        profileDescText = "あなたの作風はかなり明確です。特定の作風が強く表れており、作品に一貫した個性が生まれやすいタイプです。";
    } else if (avg >= 30) {
        profileTypeName = "明確型";
        profileDescText = "あなたの作風には、はっきりした方向性があります。いくつかの可能性を持ちながらも、中心となる作風傾向が明確です。";
    } else if (avg >= 20) {
        profileTypeName = "複合型";
        profileDescText = "あなたは複数の作風を組み合わせるタイプです。異なる作風が混ざることで、独自の表現になりやすいでしょう。";
    } else if (avg >= 10) {
        profileTypeName = "拮抗型";
        profileDescText = "あなたの中では、複数の作風が拮抗しています。一つに固定されず、作品や状況によって異なる作風が現れるタイプです。";
    } else {
        profileTypeName = "多面的型";
        profileDescText = "あなたの作風傾向は一つの言葉では捉えきれません。複数の方向性を持ち、それらを行き来できること自体があなたの作風です。";
    }

    const formattedProfileDesc = formatDescWithLineBreaks(profileDescText, null);

    document.getElementById('profile-title-1').textContent = `作風の輪郭 ｜ ${profileTypeName}`;
    document.getElementById('profile-desc-1').innerHTML = formattedProfileDesc;

    const r2S = res.style.rank2.key;
    const r2M = res.medium.rank2.key;
    const r2P = res.purpose.rank2.key;

    function getDynamicFontSize(ratio) {
        const minSize = 9;
        const maxSize = 14;
        const calculated = minSize + (maxSize - minSize) * ratio;
        return `${calculated.toFixed(1)}px`;
    }

    const sizeS = getDynamicFontSize(res.style.rank2.ratio);
    const sizeM = getDynamicFontSize(res.medium.rank2.ratio);
    const sizeP = getDynamicFontSize(res.purpose.rank2.ratio);

    document.getElementById('res-sub-axes').innerHTML = `
        <span style="color: ${COLOR_MEDIUM[r2M]}; font-size: ${sizeM};">${r2M}</span>
        <span class="sub-axis-rate">(${(res.medium.rank2.ratio * 100).toFixed(0)}%)</span> × 
        <span style="color: ${COLOR_STYLE[r2S]}; font-size: ${sizeS};">${r2S}</span>
        <span class="sub-axis-rate">(${(res.style.rank2.ratio * 100).toFixed(0)}%)</span> × 
        <span style="color: ${COLOR_PURPOSE[r2P]}; font-size: ${sizeP};">${r2P}</span>
        <span class="sub-axis-rate">(${(res.purpose.rank2.ratio * 100).toFixed(0)}%)</span>
    `;

    showScreen('screen-result');
}

function downloadResultImage() {
    if (isDownloading) return;
    isDownloading = true;

    if (calculatedResultsData) {
        recordDownloadStats(
            calculatedResultsData.style.rank1.key,
            calculatedResultsData.medium.rank1.key,
            calculatedResultsData.purpose.rank1.key
        );
    }

    const sourceCard = document.getElementById('result-card');

    document.fonts.ready.then(() => {
        html2canvas(sourceCard, {
            scale: 2,
            useCORS: true,
            backgroundColor: null,
            windowWidth: 540
        }).then(sourceCanvas => {
            const targetWidth = 1080;
            const targetHeight = 1920;
            const finalCanvas = document.createElement('canvas');
            finalCanvas.width = targetWidth;
            finalCanvas.height = targetHeight;
            const ctx = finalCanvas.getContext('2d');

            ctx.fillStyle = "#f5f3ee";
            ctx.fillRect(0, 0, targetWidth, targetHeight);

            const cardBgColor = sourceCard.style.background;
            if (cardBgColor) {
                ctx.fillStyle = cardBgColor;
                ctx.fillRect(0, 0, targetWidth, targetHeight);
            }

            ctx.drawImage(
                sourceCanvas, 
                0, 0, sourceCanvas.width, sourceCanvas.height, 
                0, 0, targetWidth, targetHeight
            );

            finalCanvas.toBlob(blob => {
                const file = new File([blob], `creative-style-result.png`, { type: 'image/png' });
                if (navigator.canShare && navigator.canShare({ files: [file] })) {
                    navigator.share({
                        files: [file],
                        title: '私という作風',
                        text: '私の創作診断結果です！'
                    }).catch(() => {}).finally(() => { isDownloading = false; });
                } else {
                    const link = document.createElement('a');
                    link.download = `creative-style-result.png`;
                    link.href = URL.createObjectURL(blob);
                    link.click();
                    setTimeout(() => { isDownloading = false; }, 500);
                }
            }, 'image/png');
        }).catch(() => { isDownloading = false; });
    });
}

function restart() {
    currentQuestionIndex = 0;
    userAnswers = [];
    uploadedImageData = null;
    calculatedResultsData = null;
    isDownloading = false;
    document.getElementById('preview-img').style.display = 'none';
    document.getElementById('preview-img').src = '';
    document.getElementById('file-label-text').textContent = "画像ファイルを選択 (ローカル処理)";
    document.getElementById('file-label-box').classList.remove('has-image');
    document.getElementById('image-reason-input').value = '';
    document.getElementById('btn-show-result').disabled = true;
    document.getElementById('char-image-input').value = '';
    document.getElementById('result-card').style.background = 'var(--card-bg)';
    showScreen('screen-start');
}
